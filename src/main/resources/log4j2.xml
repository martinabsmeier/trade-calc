<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
    <Appenders>
        <!-- Console output: human-readable for local dev. -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5p [%t] %c{1.} - %m%n%wEx"/>
        </Console>
    </Appenders>

    <Loggers>
        <!-- Application loggers: leave open for tuning per package. -->
        <Logger name="de.am.tcalc" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Quiet down third-party noise that drowns real app output. -->
        <Logger name="org.springframework.cache" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="org.springframework.boot.web" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
